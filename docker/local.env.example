# Personal settings for the local test servers. Copy this file to docker/local.env (git-ignored) and adjust.
# Any setting from https://docker-minecraft-server.readthedocs.io/ works here.

# Make yourself an operator so you can use every /shop command. Comma-separated Minecraft names.
OPS=

# Run without Mojang authentication, for example to join with several test accounts.
# ONLINE_MODE=FALSE
